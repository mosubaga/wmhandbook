---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormulaSection from '../components/FormulaSection.astro';
import { sections } from '../data/formulas.js';

const section = sections.find((item) => item.id === 'statistics');
---
<BaseLayout title="Statistics | Mathematical Handbook" currentPath="/statistics/">
  <FormulaSection section={section} />
</BaseLayout>
