---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormulaSection from '../components/FormulaSection.astro';
import { sections } from '../data/formulas.js';

const section = sections.find((item) => item.id === 'calculus');
---
<BaseLayout title="Calculus | Mathematical Handbook" currentPath="/calculus/">
  <FormulaSection section={section} />
</BaseLayout>
